{
    "name": "fast-alfred",
    "version": "2.7.0",
    "description": "Your Alfred friendly framework, for developing Alfred workflows in TypeScript/JavaScript.",
    "keywords": [],
    "homepage": "https://github.com/Avivbens/fast-alfred",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Avivbens/fast-alfred.git"
    },
    "license": "MIT",
    "author": {
        "name": "Aviv Ben Shahar",
        "email": "avivbens87@gmail.com"
    },
    "maintainers": [
        {
            "name": "Aviv Ben Shahar",
            "email": "avivbens87@gmail.com"
        }
    ],
    "exports": {
        ".": "./lib/index.js",
        "./schemas": "./lib/schemas/index.js",
        "./package.json": "./package.json"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "typesVersions": {
        "*": {
            "schemas": [
                "lib/schemas/index.d.ts"
            ]
        }
    },
    "bin": {
        "fast-alfred": "lib/bin/index.js"
    },
    "files": [
        "lib/**/*"
    ],
    "scripts": {
        "prebuild": "rm -rf ./lib",
        "build": "./scripts/build.sh",
        "docs:build": "vitepress build docs",
        "docs:dev": "vitepress dev docs",
        "docs:preview": "vitepress preview docs",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
        "prepare": "husky || exit 0",
        "prepublishOnly": "pnpm run build",
        "test": "vitest run",
        "test:debug": "vitest --inspect-brk --no-file-parallelism"
    },
    "dependencies": {
        "@nestjs/common": "^11.2.7",
        "@nestjs/core": "^11.2.7",
        "alfred-config": "^0.2.3",
        "conf": "^10.2.0",
        "esbuild": "^0.28.2",
        "glob": "^13.0.6",
        "lodash.merge": "^4.6.2",
        "nest-commander": "^3.21.0",
        "ora": "^5.4.1",
        "plist": "^3.1.1",
        "semver": "^7.8.5"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@total-typescript/ts-reset": "^0.6.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/lodash.merge": "^4.6.9",
        "@types/node": "^22.20.5",
        "@types/plist": "^3.0.5",
        "@types/semver": "^7.8.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.4.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-packagejson": "^3.0.2",
        "semantic-release": "^25.0.9",
        "tsc-alias": "^1.9.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitepress": "^1.6.4",
        "vitest": "^5.0.5",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    }
}
